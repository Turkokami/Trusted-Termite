---
/** Renders the visible FAQ from the SAME array that feeds the FAQPage node,
 *  so the two can never drift apart. Exactly one FAQ block per URL. */
import type { Faq } from '../lib/schema';
interface Props { items: Faq[]; heading?: string }
const { items, heading = 'Questions we get asked' } = Astro.props;
---
{items.length > 0 && (
  <section class="band tint">
    <div class="narrow">
      <h2>{heading}</h2>
      <div class="faq faq-speakable">
        {items.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <div class="a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
