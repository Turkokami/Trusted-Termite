/**
 * Commercial vertical — offices. C-07 verified. Last of the six.
 *
 * REGULATORY: an office is a WORKPLACE under 4 TAC §7.146(b) — the licensee
 * provides the pest control sign to the employer or building manager at least
 * 48 hours before a planned indoor treatment. §7.147(d): sign AND consumer
 * information sheet to the employer or building manager; the employer posts
 * >=48h ahead in an area of common access EMPLOYEES ARE MOST LIKELY TO SEE and
 * makes the sheet available on request during NORMAL BUSINESS HOURS.
 * §7.148(b) is the posting duty on the unlicensed party.
 * §7.146(d)/§7.148(e): no violation where the space is vacant, unused and
 * unoccupied, or where the sign is removed by an unauthorized person.
 * §7.147(g): emergency waiver needs a SIGNED statement from customer AND
 * certified applicator; emergency = "an imminent hazard to health"; treatment
 * limited to the localized area; statement kept with the use records.
 * §7.144 two-year records; §7.145 invoice/contract; §7.123 insurance.
 *
 * Pest angles used, all sourced:
 *  - German cockroach: break room; carried in; 75% of life in 1/32-3/16 in
 *    cracks; bug bombs fail; daytime sighting = large population.
 *  - American/oriental cockroach: floor drains, door thresholds, roof soffits;
 *    keep P-traps filled.
 *  - Rodents: 1/4 in standard; metal/concrete not foam/plastic/wood/rubber;
 *    thigmotaxis; mice ~30 ft home range; traps <=10 ft apart at walls.
 *  - Scorpions: enter low under doors seeking cooler temps and moisture, live
 *    high in voids and attics, drop into occupied space when attics overheat
 *    (AgriLife E-362; Molly Keck). Ground-floor suites and exterior doors.
 *  - Cockroach allergen/asthma link (NIEHS) — relevant to an occupied
 *    workplace and to any accommodation conversation.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import Crumbs from '../../components/Crumbs.astro';
