---
/**
 * /es/servicios/control-de-escorpiones/ — the flagship Spanish service page.
 *
 * VOCABULARY NOTE: the page uses "alacrán" as the primary term with "escorpión"
 * introduced once, because alacrán is the common word in northern Mexico and
 * among Mexican-American families in West Texas. The URL keeps "escorpiones"
 * for search reasons; the copy leads with alacrán.
 *
 * All biology sourced to Texas A&M AgriLife, same as the English pages:
 *  - Centruroides vittatus. Adults ~2 3/8 in, yellowish-tan, TWO broad dark
 *    longitudinal stripes, dark triangle on the head over the eyes.
 *  - LIVE BIRTH: ~8 month gestation, 13-47 young averaging 31, young ride the
 *    mother 3-7 days through a molt, 5-6 molts to maturity, lifespan ~4 years
 *    (E-362; Field Guide says 3-8 — cite 4 and note variation).
 *  - SEVERITY, non-negotiable: "None of the scorpions in Texas are considered
 *    'deadly.'" Stings "produce only moderate reactions in most people because
 *    the poison has little effect on the nervous system." The dangerous US
 *    species is the ARIZONA bark scorpion, C. sculpturatus — a different
 *    animal. This page must never imply a Texas species is lethal.
 *  - ENTRY: E-362 "During periods of hot weather, scorpions may move into
 *    living areas to escape the high temperatures in attics." Molly Keck:
 *    they seek "water and cooler temperatures and when they feel that
 *    temperature difference below a door or by another small crack, they can
 *    squeeze their way inside."
 *  - Fluoresces under UV.
 *  - MANAGEMENT, non-chemical first: remove trash, logs, boards, stones,
 *    bricks; mow short at the foundation; prune shrubs and overhanging
 *    branches; garbage above ground level; NEVER bring firewood indoors unless
 *    it goes straight on the fire; weather-strip loose doors and windows; plug
 *    weep holes with steel wool, copper mesh, nylon scouring pad or screen
 *    wire; seal roof eaves and pipe penetrations; keep screens in repair.
 *  ⚠️ Do NOT name additional Permian Basin species — AgriLife publishes counts
 *    for Amarillo/Abilene/Fort Stockton but no species list for these counties.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnswerBox from '../../../components/AnswerBox.astro';
import Trust from '../../../components/Trust.astro';
import Crumbs from '../../../components/Crumbs.astro';
import Faq from '../../../components/Faq.astro';
import Cta from '../../../components/Cta.astro';
import { BUSINESS } from '../../../data/business';

const o = BUSINESS.owner;
const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Servicios', path: '/es/servicios/' },
  { name: 'Control de Alacranes', path: '/es/servicios/control-de-escorpiones/' },
];

const quickAnswer =
  'El alacrán rayado de corteza es la plaga que define esta región, y no es mortal — Texas A&M AgriLife señala que ninguna especie de alacrán en Texas se considera mortal. Entran buscando frescura y humedad, por debajo de las puertas, y viven arriba en áticos y paredes. El trabajo es sellar y quitar refugio mucho más que rociar.';

const faqs = [
