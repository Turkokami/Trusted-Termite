const crumbs = [
  { name: 'Inicio', path: '/es/' },
  { name: 'Servicios', path: '/es/servicios/' },
  { name: 'Jardinería y Control de Maleza', path: '/es/servicios/jardineria-y-control-de-maleza/' },
];

const quickAnswer =
  'Corte, orilladora, fertilización, poda de árboles y aplicación de herbicida en el condado de Gaines y la Cuenca Pérmica. Valentin Moriel tiene las categorías estatales de Jardín y Ornamental y de Control de Maleza, que son licencias aparte del control de plagas, y hace el trabajo personalmente bajo la licencia TPCL 0918482.';

const faqs = [
  {
    q: '¿Por qué un servicio de jardín necesita licencia?',
    a: 'Cortar el pasto no la necesita. Aplicar herbicida en la propiedad de otra persona a cambio de dinero, sí. Texas otorga las categorías de Jardín y Ornamental y de Control de Maleza por separado dentro del servicio estructural de control de plagas, con examen propio y mantenimiento propio cada una. Mucha gente que corta pasto por dinero en esta región no tiene licencia para aplicar químicos, y si el plan para su propiedad incluye cualquier producto, eso conviene verificarlo antes del trabajo y no después.',
  },
