import { SERVICES } from '../../../data/services';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/locations/' },
  { name: 'Midland', path: '/locations/midland/' },
  { name: 'Briarwood', path: '/locations/midland/briarwood/' },
];

const quickAnswer =
  'Briarwood in north-west Midland was platted from 1984 and built out over nearly thirty years. Its association runs two swimming pools, which matters more than it sounds: pool equipment that stops circulating becomes mosquito habitat in about a week. Work here is carried out personally by the licence holder, Valentin Moriel, TPCL 0976265.';

const faqs = [
  {
    q: 'How can a swimming pool cause a mosquito problem?',
    a: 'By stopping. A pool that is circulating and chlorinated is not mosquito habitat — the water moves, the chemistry is hostile, and eggs do not survive it. A pool whose pump fails, or whose filtration is switched off, or that is covered and left over winter with rainwater on top of the cover, becomes still water within days. Mosquitoes need roughly a week of standing water to complete a generation, and a swimming pool holds tens of thousands of gallons of it. One neglected pool can out-produce every flowerpot saucer on a street combined. It is worth knowing that the Briarwood association itself had to carry out major pool repairs for equipment failures in 2018 — not as criticism, but because it shows that pool plant does fail, and when it does the clock starts.',
  },
  {
    q: 'What should I do about my own pool?',
