const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/locations/' },
  { name: 'Midland', path: '/locations/midland/' },
  { name: 'Grassland Estates', path: '/locations/midland/grassland-estates/' },
];

const quickAnswer =
  'Grassland Estates has been under construction since July 1984 and has never stopped — twenty-seven sections, the most recent recorded this year. That means every slab age from forty-two years to brand new sits on one street grid, and the right inspection depends entirely on which section you are in. The licence holder, Valentin Moriel, does the work himself under TPCL 0918482.';

