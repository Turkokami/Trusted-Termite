import { SERVICES } from '../../data/services';

const town = townBySlug('odessa')!;
const hoods = neighborhoodsOf('odessa');
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Areas we serve', path: '/locations/' },
  { name: 'Odessa', path: '/locations/odessa/' },
];

const quickAnswer =
  'Trusted Termite and Pest Solutions covers Odessa, Texas from a base in Seminole, about 65 miles north. Owner Valentin Moriel holds Texas Department of Agriculture licence TPCL 0918482 and handles bed bugs, roaches, fire ants, scorpions, lot clearing and property cleanouts across Ector County.';

const faqs = [
  {
    q: 'Why are bed bugs such a problem in Odessa?',
    a: 'Turnover. Odessa ran a 21.3% rental vacancy rate at the 2020 census — one of the highest in the region — and high residential turnover is the classic driver of bed bug spread. Every move-in and move-out is an opportunity for them to travel. It is not a reflection on any property or any tenant; it is a mathematical consequence of how often units change hands in an oilfield city.',
  },
  {
    q: 'How is bed bug treatment priced?',
    a: 'Individually, after we look at it. Price depends on the size of the home, the number of rooms affected, the severity of the infestation, how much preparation is required and whether follow-up treatments will be necessary. A light infestation in one bedroom and a severe whole-home infestation are completely different jobs and it would be dishonest to quote them the same. We treat chemically — we do not offer heat treatment, and if a job genuinely needs heat we will tell you that rather than sell you something that will not do it.',
  },
  {
    q: 'What is the weed and grass rule in Odessa?',
    a: 'Twelve inches. Odessa Code Article 6-5 defines any grass, weeds or wild brush exceeding twelve inches as a nuisance, and you get 5 days to request a hearing or 7 days to clear it. If the city does the work, the costs are itemised: major equipment at $56 per hour, labour at $21 per hour, a $125 flat administration fee, landfill at $52.50 per ton, plus a 10% late fee, and it becomes a lien at 10% annual interest that can be foreclosed. There is also a 48-inch threshold where the city can abate immediately with no notice at all.',
  },
  {
    q: 'Do I have fire ants in Odessa?',
    a: 'Possibly. Ector County IS on the Texas Department of Agriculture red imported fire ant quarantine list, unlike Gaines, Andrews, Yoakum and Dawson counties further west. So the question is genuinely open here in a way it is not in Seminole. Identification first, because a fire ant programme and a red harvester ant treatment are different jobs.',
  },
  {
    q: 'Do you do apartment and rental property work?',
    a: 'Yes — apartments and property management is one of the commercial types we actually work. Two rules matter if you manage units in Texas. Property Code §92.052 requires landlords to make diligent efforts to repair conditions that materially affect the physical health or safety of an ordinary tenant, and pest problems can qualify. And 4 TAC §7.146 requires a pest control sign at least 48 hours before a planned indoor treatment at residential rental property with five or more units. The Texas Department of Agriculture publishes a standard Spanish-language version of that sign.',
  },
  {
    q: 'Which parts of Odessa do you cover?',
    a: 'North and northeast Odessa primarily, including Mission Estates and the Parks Bell Ranch area, plus surrounding residential and commercial property. We cover the rest of the city too; that side is where the route density is.',
  },
  {
    q: 'You are in Seminole. Is Odessa far for you?',
    a: 'About 65 miles south, well inside the hundred-mile working radius, and one of the more regular runs. There is no trip fee. For a single small job we may discuss a job minimum up front, but for most Odessa work it is a straightforward booking.',
  },
  {
    q: '¿Hablan español en Odessa?',
    a: 'Sí. Valentin habla español con fluidez y atiende personalmente. Puede llamar o enviar un mensaje de texto al (432) 278-7294 y hablar directamente con el dueño.',
  },
