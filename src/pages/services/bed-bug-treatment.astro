 *
 * Data sources: services.ts (products: Alpine WSG, Precor IGR, Transport;
 * licence category Pest Control; guaranteeApplies FALSE).
 *
 * HARD HONESTY GATES ON THIS PAGE:
 *  - NO HEAT TREATMENT. It is in the EXCLUDED list in services.ts. This page
 *    must state plainly that heat is not offered and that where heat is the
 *    right answer, the customer needs a different provider.
 *  - NO FUMIGATION. Not certified for it.
 *  - No pricing figures. No claims about eradication rates, timeframes or
 *    "one visit" outcomes. No disease claims — bed bugs are not established
 *    as disease vectors and the page must not imply they are.
 *  - No stigma language. The single most important message is that bed bugs
 *    are an introduction problem, not a cleanliness problem.
 *
 * Regional grounding: I-20 corridor lodging at Stanton; oilfield man camps,
 * RV parks and short-cycle rental turnover across the Permian (verified on
 * the Denver City and locations pages); high rental share in Lubbock (51.2%
 * renter, verified on the Lubbock page).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import Trust from '../../components/Trust.astro';
import Crumbs from '../../components/Crumbs.astro';
import Faq from '../../components/Faq.astro';
