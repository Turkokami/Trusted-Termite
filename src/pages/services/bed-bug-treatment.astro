import SpokeLinks from '../../components/SpokeLinks.astro';
import { serviceBySlug } from '../../data/services';
import { TOWNS } from '../../data/towns';

const svc = serviceBySlug('bed-bug-treatment')!;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: svc.name, path: '/services/bed-bug-treatment/' },
];

const quickAnswer =
  'Bed bug treatment from Trusted Termite and Pest Solutions is chemical treatment, quoted individually, because a light infestation and a severe whole-home infestation are completely different jobs. Valentin Moriel carries out the work himself under TPCL 0918482, and does it discreetly. We do not offer heat treatment, and where heat is the right answer we will tell you so rather than sell you something adjacent.';

const faqs = [
  {
    q: 'Do you do heat treatment?',
    a: 'No. Heat is a legitimate method requiring specific equipment we do not carry, and we are not going to imply otherwise. What we offer is conventional chemical treatment with a follow-up schedule. Where heat is genuinely the right answer for your situation — and sometimes it is — you need a provider who does it, and we will say so on the phone rather than after taking a booking.',
  },
  {
    q: 'Does having bed bugs mean my house is dirty?',
    a: 'No, and this is the single most important thing on this page. Bed bugs are an introduction problem, not a sanitation problem. They arrive in luggage, in second-hand furniture, in a bag set down somewhere, on clothing. Spotless homes get them and always have. The only thing housekeeping changes is how easy they are to find, because clutter gives them more places to be.',
  },
  {
    q: 'How do I know it is actually bed bugs?',
    a: 'Look for the physical evidence rather than at the bites. Small dark spots along a mattress seam, on the box spring, or on the frame where the joints meet. Shed skins. Live insects roughly the size and shape of an apple seed, flattened and reddish-brown. Bites alone are unreliable — people react very differently, some not at all, and several other things bite. If you can photograph what you have found, text it before the visit.',
  },
  {
    q: 'Can you treat it in one visit?',
    a: 'Not honestly. Bed bug work is a sequence, not an event, because eggs are not affected by treatment the way active insects are and a second visit at the right interval is what deals with what hatches afterwards. Anyone promising a single-visit resolution is either using a method they have not explained or telling you what you want to hear.',
  },
  {
    q: 'Is bed bug work covered by the 30-day guarantee?',
    a: 'No. It carries its own agreed terms instead, set before the work starts. The reason is that the outcome depends heavily on preparation being completed, on the follow-up visits happening on schedule, and on the source of the introduction not continuing — none of which a blanket thirty-day promise handles honestly.',
  },
  {
    q: 'What do you use?',
    a: 'Alpine WSG, Precor IGR and Transport, selected and placed for the situation. The insect growth regulator matters as much as the adulticide, because it addresses the part of the population that is not currently an adult. Placement is determined by where the harbourage actually is, which is what the inspection establishes.',
  },
  {
    q: 'Will the neighbours know?',
    a: 'Not from us. There is no branded wrap announcing what we are treating, and we will not discuss your property with anybody who is not authorised on the job. If discretion matters to you — and for a good many people it does — say so when you book and it will be planned around.',
  },
  {
    q: '¿Hacen tratamiento de chinches en español?',
    a: 'Sí. Valentin habla español con fluidez y le explica personalmente cómo preparar la casa y qué esperar en cada visita. Llame o mande un texto al (432) 278-7294.',
