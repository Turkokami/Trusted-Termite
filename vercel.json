{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/pest-control-seminole/",
      "destination": "/locations/seminole/",
      "permanent": true
    },
    {
      "source": "/pest-control-seagraves/",
      "destination": "/locations/seagraves/",
      "permanent": true
    },
    {
      "source": "/pest-control-denver-city/",
      "destination": "/locations/denver-city/",
      "permanent": true
    },
    {
      "source": "/pest-control-andrews/",
      "destination": "/locations/andrews/",
      "permanent": true
    },
    {
      "source": "/pest-control-lamesa/",
      "destination": "/locations/lamesa/",
      "permanent": true
    },
    {
      "source": "/pest-control-big-spring/",
      "destination": "/locations/big-spring/",
      "permanent": true
    },
    {
      "source": "/pest-control-midland/",
      "destination": "/locations/midland/",
      "permanent": true
    },
    {
      "source": "/pest-control-odessa/",
      "destination": "/locations/odessa/",
      "permanent": true
    },
    {
      "source": "/pest-control-lubbock/",
      "destination": "/locations/lubbock/",
      "permanent": true
    },
    {
      "source": "/pest-control-kermit/",
      "destination": "/locations/kermit/",
      "permanent": true
    },
    {
      "source": "/lawn-care/",
      "destination": "/services/lawn-care/",
      "permanent": true
    },
    {
      "source": "/schedule-service/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/testimonials/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/financing/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ]
}
